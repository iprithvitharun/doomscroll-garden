{
  "manifest_version": 3,
  "name": "Doomscroll Garden",
  "version": "0.4.0",
  "description": "Vines take over your feeds while you scroll, until you can't see the page. Cut them down and they grow back faster.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Doomscroll Garden",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.linkedin.com/*",
        "https://www.youtube.com/*",
        "https://bsky.app/*",
        "https://www.facebook.com/*"
      ],
      "js": [
        "src/atlas.js",
        "src/util.js",
        "src/margins.js",
        "src/overgrowth.js",
        "src/styles.js",
        "src/cut.js",
        "src/creatures.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "art/atlas.png",
        "art/photo/*.png"
      ],
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.instagram.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://www.linkedin.com/*",
        "https://www.youtube.com/*",
        "https://bsky.app/*",
        "https://www.facebook.com/*"
      ]
    }
  ]
}
